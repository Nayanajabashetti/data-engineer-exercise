# Optional env file for MWAA preflight + DAG sync (not loaded automatically).
# Usage:
#   export $(grep -v '^#' mwaa.env | xargs)   # if you copy this to mwaa.env
# Or paste exports into your shell:
#
# MWAA_ENV_NAME=search-keyword-airflow
# DATA_BUCKET=acs-keyword-revenue-nayanaj
# AWS_REGION=us-west-2
#
# ./scripts/mwaa_preflight_and_sync.sh
